    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "dependencies": {
    "d3": "7.9.0",
    "d3-graphviz": "5.0.2"
  },
  "overrides": {
    "@hpcc-js/wasm": "2.13.0"
  }
}
