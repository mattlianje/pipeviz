{
  "name": "pipeviz-js",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pipeviz JS - Easy, elegant lineage from a single JSON",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
